// qw_dequant_shvq.metalh — Signed Hadamard e-means Vector Quantized (SHVQ)
// unpackers and GEMV slice dot helpers for SHVQ{1,15,2,3,4}_G{32,64,128,256}.
// Group layout: 2-byte f16 scale header (zero bias) + payload bytes.

#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
#include "qw_dequant.metalh"
#include "qw_dequant_f32.metalh"
#include "qw_shvq_tables.metalh"
#include "qw_shvq_routed_lut.metalh"
#include "qw_dequant_shvq_sub2.metalh"
using namespace metal;

template <int BITS, bool DIRECT4 = false>
METAL_FUNC half4 qwg_shvq_unpack_quad4(device const uchar* p, uint quadIdx) {
    if constexpr (BITS == 1) {
        return qwg_shvq_unpack_quad4_1(p, quadIdx);
    } else if constexpr (BITS == 15) {
        return qwg_shvq_unpack_quad4_15<DIRECT4>(p, quadIdx);
    }
    ushort4 pos;
    uint signs4;
    if constexpr (BITS == 2) {
        const uint oct = quadIdx >> 1u;
        const uint halfId = quadIdx & 1u;
        signs4 = (uint(p[2u * oct]) >> (halfId * 4u)) & 0x0Fu;
        const uint vecIdx = (uint(p[2u * oct + 1u]) << 1u) + halfId;
        pos = ((constant const ushort4*)kShvqLut2Bits)[vecIdx];
    } else if constexpr (BITS == 3) {
        const uint oct = quadIdx >> 1u;
        const uint halfId = quadIdx & 1u;
        signs4 = (uint(p[3u * oct]) >> (halfId * 4u)) & 0x0Fu;
        const uint vecIdx = uint(p[3u * oct + 1u + halfId]);
        pos = ((constant const ushort4*)kShvqLut3Bits)[vecIdx];
    } else {
        const ushort u16 = *(device const ushort*)(p + 2u * quadIdx);
        signs4 = uint(u16 >> 12u);
        if constexpr (DIRECT4) {
            pos = ((constant const ushort4*)kShvqLut4DirectBits)[u16 & 0x0FFFu];
        } else {
#ifdef QW_SHVQ_ROUTED_DIRECT_LUT
            pos = ((constant const ushort4*)kShvqLut4DirectBits)[u16 & 0x0FFFu];
#else
            const uchar4 c = as_type<uchar4>(kShvqLut4PackedU8[u16 & 0x0FFFu]);
            pos = as_type<ushort4>(half4(float4(c) * kShvq4StepScaleF32));
#endif
        }
    }
    const ushort4 sMask = (ushort4(ushort(signs4)) << ushort4(15u, 14u, 13u, 12u)) & ushort4(0x8000u);
    return as_type<half4>(pos | sMask);
}

template <int BITS>
struct ShvqTgLut;

template <int BITS, bool HAS_TG>
METAL_FUNC void qwg_shvq_unpack_oct8_impl(device const uchar* p, uint oct,
                                          threadgroup const ShvqTgLut<BITS>* tgLut,
                                          thread half4 &uLo, thread half4 &uHi);

template <int BITS>
METAL_FUNC void qwg_shvq_unpack_oct8(device const uchar* p, uint oct,
                                     thread half4 &uLo, thread half4 &uHi) {
    qwg_shvq_unpack_oct8_impl<BITS, false>(p, oct, nullptr, uLo, uHi);
}

#ifndef QW_SHVQ_ROUTED_DIRECT_LUT
template <bool SUB2 = false>
METAL_FUNC float qwg_shvq_read_elem_t(device const char* gp, uint bits, uint colInGroup) {
    const float sc = float(*(device const half*)gp);
    device const uchar* p = (device const uchar*)(gp + 2);
    const uint q = colInGroup >> 2u;
    const uint sub = colInGroup & 3u;
    half4 v;
    if constexpr (SUB2) {
        if (bits == 1u) {
            v = qwg_shvq_unpack_quad4<1>(p, q);
        } else {
            v = qwg_shvq_unpack_quad4<15>(p, q);
        }
    } else {
        if (bits == 2u) {
            v = qwg_shvq_unpack_quad4<2>(p, q);
        } else if (bits == 3u) {
            v = qwg_shvq_unpack_quad4<3>(p, q);
        } else {
            v = qwg_shvq_unpack_quad4<4>(p, q);
        }
    }
    return float(v[sub]) * sc;
}

METAL_FUNC float qwg_shvq_read_elem(device const char* gp, uint bits, uint colInGroup) {
    return qwg_shvq_read_elem_t<false>(gp, bits, colInGroup);
}
#endif

template <int BITS, bool DIRECT4 = false, bool HAS_TG_LUT = false>
METAL_FUNC half4 qwg_shvq_unpack_quad4_tg(device const uchar* p, uint quadIdx,
                                          threadgroup const ushort4* lut16) {
    if constexpr (!HAS_TG_LUT || BITS == 4 || BITS == 15) {
        (void)lut16;
        return qwg_shvq_unpack_quad4<BITS, DIRECT4>(p, quadIdx);
    } else if constexpr (BITS == 1) {
        const uchar b = p[quadIdx >> 1u];
        const uint vecIdx = (uint(b & 0x7Fu) << 1u) + (quadIdx & 1u);
        return as_type<half4>(lut16[vecIdx] ^ ushort4(ushort(uint(b & 0x80u) << 8u)));
    } else if constexpr (BITS == 2) {
        const uint oct = quadIdx >> 1u, halfId = quadIdx & 1u;
        const uint signs4 = (uint(p[2u * oct]) >> (halfId * 4u)) & 0x0Fu;
        const ushort4 pos = lut16[(uint(p[2u * oct + 1u]) << 1u) + halfId];
        return as_type<half4>(pos | ((ushort4(ushort(signs4)) << ushort4(15u, 14u, 13u, 12u)) & ushort4(0x8000u)));
    } else {
        const uint oct = quadIdx >> 1u, halfId = quadIdx & 1u;
        const uint signs4 = (uint(p[3u * oct]) >> (halfId * 4u)) & 0x0Fu;
        const ushort4 pos = lut16[uint(p[3u * oct + 1u + halfId])];
        return as_type<half4>(pos | ((ushort4(ushort(signs4)) << ushort4(15u, 14u, 13u, 12u)) & ushort4(0x8000u)));
    }
}

template <int BITS, bool DIRECT4 = false, bool HAS_TG_LUT = false>
METAL_FUNC void qwg_shvq_frag8_tg(device const char* gp, uint colInGroup,
                                  threadgroup const ushort4* lut16,
                                  thread half4 &lo, thread half4 &hi) {
    const half sc = *(device const half*)gp;
    device const uchar* p = (device const uchar*)(gp + 2);
    const uint q0 = colInGroup >> 2u;
    lo = qwg_shvq_unpack_quad4_tg<BITS, DIRECT4, HAS_TG_LUT>(p, q0, lut16) * sc;
    hi = qwg_shvq_unpack_quad4_tg<BITS, DIRECT4, HAS_TG_LUT>(p, q0 + 4u, lut16) * sc;
}

template <int BITS, bool DIRECT4 = false>
METAL_FUNC void qwg_shvq_frag8(device const char* gp, uint colInGroup,
                               thread half4 &lo, thread half4 &hi) {
    qwg_shvq_frag8_tg<BITS, DIRECT4, false>(gp, colInGroup, nullptr, lo, hi);
}

METAL_FUNC void qwg_shvq_load_half32(device const half* xg,
                                     thread half4 (&lo)[4],
                                     thread half4 (&hi)[4]) {
    #pragma unroll
    for (uint w = 0u; w < 4u; ++w) {
        qwg_load_half8(xg + w * 8u, lo[w], hi[w]);
    }
}

METAL_FUNC void qwg_shvq_load_float32(device const float* xg,
                                      thread float4 (&lo)[4],
                                      thread float4 (&hi)[4]) {
    #pragma unroll
    for (uint w = 0u; w < 4u; ++w) {
        device const float4* p4 = (device const float4*)(xg + w * 8u);
        lo[w] = p4[0];
        hi[w] = p4[1];
    }
}

template <int BITS>
struct ShvqTgLut;

template <int BITS>
METAL_FUNC void qwg_shvq_unpack_oct8_tg(device const uchar* p, uint oct,
                                        threadgroup const ShvqTgLut<BITS> &tgLut,
                                        thread half4 &uLo, thread half4 &uHi);

template <int BITS, bool HAS_TG, typename Vec4>
METAL_FUNC float qwg_shvq_slice_dot_impl(device const char* gp, uint byteInGroup,
                                         thread const Vec4 (&lo)[4], thread const Vec4 (&hi)[4],
                                         threadgroup const ShvqTgLut<BITS>* tgLut) {
    const float sc = float(*(device const half*)gp);
    device const uchar* p = (device const uchar*)(gp + 2 + byteInGroup);
    float acc = 0.0f;
    #pragma unroll
    for (uint w = 0u; w < 4u; ++w) {
        half4 uLo, uHi;
        if constexpr (HAS_TG) qwg_shvq_unpack_oct8_tg<BITS>(p, w, *tgLut, uLo, uHi);
        else                  qwg_shvq_unpack_oct8<BITS>(p, w, uLo, uHi);
        acc += dot(float4(uLo), float4(lo[w])) + dot(float4(uHi), float4(hi[w]));
    }
    return acc * sc;
}

template <int BITS, bool HAS_TG, typename Vec4>
METAL_FUNC float2 qwg_shvq_slice_dot2_impl(device const char* gp, uint byteInGroup,
                                           thread const Vec4 (&lo0)[4], thread const Vec4 (&hi0)[4],
                                           thread const Vec4 (&lo1)[4], thread const Vec4 (&hi1)[4],
                                           threadgroup const ShvqTgLut<BITS>* tgLut) {
    const float sc = float(*(device const half*)gp);
    device const uchar* p = (device const uchar*)(gp + 2 + byteInGroup);
    float2 acc = float2(0.0f);
    #pragma unroll
    for (uint w = 0u; w < 4u; ++w) {
        half4 uLo, uHi;
        if constexpr (HAS_TG) qwg_shvq_unpack_oct8_tg<BITS>(p, w, *tgLut, uLo, uHi);
        else                  qwg_shvq_unpack_oct8<BITS>(p, w, uLo, uHi);
        const float4 fLo = float4(uLo), fHi = float4(uHi);
        acc.x += dot(fLo, float4(lo0[w])) + dot(fHi, float4(hi0[w]));
        acc.y += dot(fLo, float4(lo1[w])) + dot(fHi, float4(hi1[w]));
    }
    return acc * sc;
}

template <int BITS, typename Vec4>
METAL_FUNC float qwg_shvq_slice_dot(device const char* gp, uint byteInGroup,
                                    thread const Vec4 (&lo)[4], thread const Vec4 (&hi)[4]) {
    return qwg_shvq_slice_dot_impl<BITS, false>(gp, byteInGroup, lo, hi, nullptr);
}

template <int BITS, typename Vec4>
METAL_FUNC float2 qwg_shvq_slice_dot2(device const char* gp, uint byteInGroup,
                                      thread const Vec4 (&lo0)[4], thread const Vec4 (&hi0)[4],
                                      thread const Vec4 (&lo1)[4], thread const Vec4 (&hi1)[4]) {
    return qwg_shvq_slice_dot2_impl<BITS, false>(gp, byteInGroup, lo0, hi0, lo1, hi1, nullptr);
}

template <int BITS, int GROUP>
METAL_FUNC void qwg_unpack_shvq_lane4_f32(device const char* wrow,
                                          uint g32,
                                          uint dl,
                                          thread float2 &w01,
                                          thread float2 &w23) {
    const uint col = g32 << 5u;
    constexpr uint groupBytes = qwg_shvq_group_bytes(BITS, GROUP);
    device const char* gp = wrow + size_t(col / uint(GROUP)) * groupBytes;
    const float sc = float(*(device const half*)gp);
    device const uchar* p = (device const uchar*)(gp + 2);
    const uint quadIdx = ((col % uint(GROUP)) >> 2u) + dl;
    const float4 v = float4(qwg_shvq_unpack_quad4<BITS>(p, quadIdx)) * sc;
    w01 = v.xy;
    w23 = v.zw;
}

template <int BITS>
struct ShvqTgLut;

template <>
struct ShvqTgLut<1> {
    uint4 lut[128];
    METAL_FUNC void load(uint ti, uint tptg) threadgroup {
        constant const uint4* src = (constant const uint4*)kShvqLut1Bits;
        for (uint i = ti; i < 128u; i += tptg) lut[i] = src[i];
    }
    METAL_FUNC threadgroup const ushort4* ptr16() const threadgroup {
        return (threadgroup const ushort4*)lut;
    }
};

template <>
struct ShvqTgLut<15> {
    uint dummy[1];
    METAL_FUNC void load(uint ti, uint tptg) threadgroup {
        if (ti == 0u && tptg > 0u) dummy[0] = 0u;
    }
    METAL_FUNC threadgroup const ushort4* ptr16() const threadgroup {
        return (threadgroup const ushort4*)dummy;
    }
};

template <>
struct ShvqTgLut<2> {
    uint4 lut[256];
    METAL_FUNC void load(uint ti, uint tptg) threadgroup {
        constant const uint4* src = (constant const uint4*)kShvqLut2Bits;
        for (uint i = ti; i < 256u; i += tptg) lut[i] = src[i];
    }
    METAL_FUNC threadgroup const ushort4* ptr16() const threadgroup {
        return (threadgroup const ushort4*)lut;
    }
};

template <>
struct ShvqTgLut<3> {
    ushort4 lut[256];
    METAL_FUNC void load(uint ti, uint tptg) threadgroup {
        constant const ushort4* src = (constant const ushort4*)kShvqLut3Bits;
        for (uint i = ti; i < 256u; i += tptg) lut[i] = src[i];
    }
    METAL_FUNC threadgroup const ushort4* ptr16() const threadgroup {
        return lut;
    }
};

template <>
struct ShvqTgLut<4> {
    uint dummy[1];
    METAL_FUNC void load(uint ti, uint tptg) threadgroup {
        if (ti == 0u && tptg > 0u) dummy[0] = 0u;
    }
    METAL_FUNC threadgroup const ushort4* ptr16() const threadgroup {
        return (threadgroup const ushort4*)dummy;
    }
};

template <int BITS, bool HAS_TG>
METAL_FUNC void qwg_shvq_unpack_oct8_impl(device const uchar* p, uint oct,
                                          threadgroup const ShvqTgLut<BITS>* tgLut,
                                          thread half4 &uLo, thread half4 &uHi) {
    if constexpr (BITS == 1) {
        if constexpr (HAS_TG) {
            const uchar b = p[oct];
            const uint4 raw128 = tgLut->lut[uint(b & 0x7Fu)];
            const ushort4 s4 = ushort4(ushort(uint(b & 0x80u) << 8u));
            uLo = as_type<half4>(as_type<ushort4>(raw128.xy) ^ s4);
            uHi = as_type<half4>(as_type<ushort4>(raw128.zw) ^ s4);
        } else {
            qwg_shvq_unpack_oct8_1(p, oct, uLo, uHi);
        }
    } else if constexpr (BITS == 15) {
        qwg_shvq_unpack_oct8_15(p, oct, uLo, uHi);
    } else if constexpr (BITS == 2) {
        const ushort signs = ushort(p[2u * oct]);
        const uint code = uint(p[2u * oct + 1u]);
        const uint4 raw128 = HAS_TG ? tgLut->lut[code] : ((constant const uint4*)kShvqLut2Bits)[code];
        const ushort4 sLo = (ushort4(signs) << ushort4(15u, 14u, 13u, 12u)) & ushort4(0x8000u);
        const ushort4 sHi = (ushort4(signs) << ushort4(11u, 10u, 9u, 8u)) & ushort4(0x8000u);
        uLo = as_type<half4>(as_type<ushort4>(raw128.xy) | sLo);
        uHi = as_type<half4>(as_type<ushort4>(raw128.zw) | sHi);
    } else if constexpr (BITS == 3) {
        const ushort signs = ushort(p[3u * oct]);
        const uint c0 = uint(p[3u * oct + 1u]), c1 = uint(p[3u * oct + 2u]);
        const ushort4 pLo = HAS_TG ? tgLut->lut[c0] : ((constant const ushort4*)kShvqLut3Bits)[c0];
        const ushort4 pHi = HAS_TG ? tgLut->lut[c1] : ((constant const ushort4*)kShvqLut3Bits)[c1];
        const ushort4 sLo = (ushort4(signs) << ushort4(15u, 14u, 13u, 12u)) & ushort4(0x8000u);
        const ushort4 sHi = (ushort4(signs) << ushort4(11u, 10u, 9u, 8u)) & ushort4(0x8000u);
        uLo = as_type<half4>(pLo | sLo);
        uHi = as_type<half4>(pHi | sHi);
    } else {
        uLo = qwg_shvq_unpack_quad4<4>(p, 2u * oct);
        uHi = qwg_shvq_unpack_quad4<4>(p, 2u * oct + 1u);
    }
}

template <int BITS>
METAL_FUNC void qwg_shvq_unpack_oct8_tg(device const uchar* p, uint oct,
                                        threadgroup const ShvqTgLut<BITS> &tgLut,
                                        thread half4 &uLo, thread half4 &uHi) {
    qwg_shvq_unpack_oct8_impl<BITS, true>(p, oct, &tgLut, uLo, uHi);
}

template <int BITS, typename Vec4>
METAL_FUNC float qwg_shvq_slice_dot_tg(device const char* gp, uint byteInGroup,
                                       thread const Vec4 (&lo)[4], thread const Vec4 (&hi)[4],
                                       threadgroup const ShvqTgLut<BITS> &tgLut) {
    return qwg_shvq_slice_dot_impl<BITS, true>(gp, byteInGroup, lo, hi, &tgLut);
}

template <int BITS, typename Vec4>
METAL_FUNC float2 qwg_shvq_slice_dot2_tg(device const char* gp, uint byteInGroup,
                                         thread const Vec4 (&lo0)[4], thread const Vec4 (&hi0)[4],
                                         thread const Vec4 (&lo1)[4], thread const Vec4 (&hi1)[4],
                                         threadgroup const ShvqTgLut<BITS> &tgLut) {
    return qwg_shvq_slice_dot2_impl<BITS, true>(gp, byteInGroup, lo0, hi0, lo1, hi1, &tgLut);
}

template <int BITS, int GROUP, uint ROWS, bool HAS_TG>
METAL_FUNC float4 qwg_gemv_shvq_rowsN_impl(device const char* blocks,
                                           device const half* x,
                                           uint row0,
                                           uint N,
                                           uint K,
                                           uint lane,
                                           threadgroup const ShvqTgLut<BITS>* tgLut) {
    const uint nBlocks = K >> 5u;
    constexpr uint groupBytes = qwg_shvq_group_bytes(BITS, GROUP);
    const uint rowBytes = (K / uint(GROUP)) * groupBytes;
    device const char* r0 = blocks + (size_t)row0 * rowBytes;
    device const char* r1 = (ROWS > 1u && row0 + 1u < N) ? (r0 + rowBytes) : r0;
    device const char* r2 = (ROWS > 2u && row0 + 2u < N) ? (r0 + 2u * rowBytes) : r0;
    device const char* r3 = (ROWS > 3u && row0 + 3u < N) ? (r0 + 3u * rowBytes) : r0;
    float4 acc = float4(0.0f);
    for (uint g = lane; g < nBlocks; g += 32u) {
        const uint col = g << 5u;
        half4 xlo[4], xhi[4];
        qwg_shvq_load_half32(x + col, xlo, xhi);
        const size_t groupOff = size_t(col / uint(GROUP)) * groupBytes;
        const uint byteInGroup = qwg_shvq_byte_in_group<BITS, GROUP>(col);
        if constexpr (HAS_TG) {
            acc.x += qwg_shvq_slice_dot_tg<BITS>(r0 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 1u) acc.y += qwg_shvq_slice_dot_tg<BITS>(r1 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 2u) acc.z += qwg_shvq_slice_dot_tg<BITS>(r2 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 3u) acc.w += qwg_shvq_slice_dot_tg<BITS>(r3 + groupOff, byteInGroup, xlo, xhi, *tgLut);
        } else {
            acc.x += qwg_shvq_slice_dot<BITS>(r0 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 1u) acc.y += qwg_shvq_slice_dot<BITS>(r1 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 2u) acc.z += qwg_shvq_slice_dot<BITS>(r2 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 3u) acc.w += qwg_shvq_slice_dot<BITS>(r3 + groupOff, byteInGroup, xlo, xhi);
        }
    }
    #pragma unroll
    for (uint r = 0u; r < ROWS; ++r) acc[r] = qwg_simd_reduce_down<32u>(acc[r]);
    return acc;
}

template <int BITS, int GROUP, uint ROWS>
METAL_FUNC float4 qwg_gemv_shvq_rowsN_tg(device const char* blocks, device const half* x,
                                         uint row0, uint N, uint K, uint lane,
                                         threadgroup const ShvqTgLut<BITS> &tgLut) {
    return qwg_gemv_shvq_rowsN_impl<BITS, GROUP, ROWS, true>(blocks, x, row0, N, K, lane, &tgLut);
}

template <int BITS, int GROUP, uint ROWS>
METAL_FUNC float4 qwg_gemv_shvq_rowsN(device const char* blocks, device const half* x,
                                      uint row0, uint N, uint K, uint lane) {
    return qwg_gemv_shvq_rowsN_impl<BITS, GROUP, ROWS, false>(blocks, x, row0, N, K, lane, nullptr);
}

template <int BITS, int GROUP, typename OutT = float>
METAL_FUNC void qwg_gemv_shvq_rows4_m(device const char* blocks,
                                      device const half* x,
                                      device OutT* y,
                                      uint row0,
                                      uint realN,
                                      uint K,
                                      uint mRows,
                                      uint lane,
                                      threadgroup const ShvqTgLut<BITS> &tgLut) {
    const uint nBlocks = K >> 5u;
    constexpr uint groupBytes = qwg_shvq_group_bytes(BITS, GROUP);
    const uint rowBytes = (K / uint(GROUP)) * groupBytes;
    device const char* r0 = blocks + (size_t)row0 * rowBytes;
    device const char* r1 = (row0 + 1u < realN) ? (r0 + rowBytes) : r0;
    device const char* r2 = (row0 + 2u < realN) ? (r0 + 2u * rowBytes) : r0;
    device const char* r3 = (row0 + 3u < realN) ? (r0 + 3u * rowBytes) : r0;
    float4 acc[8];
    #pragma unroll
    for (uint m = 0u; m < 8u; ++m) acc[m] = float4(0.0f);
    for (uint g = lane; g < nBlocks; g += 32u) {
        const uint col = g << 5u;
        const size_t groupOff = size_t(col / uint(GROUP)) * groupBytes;
        const uint byteInGroup = qwg_shvq_byte_in_group<BITS, GROUP>(col);
        device const char* gp0 = r0 + groupOff;
        device const char* gp1 = r1 + groupOff;
        device const char* gp2 = r2 + groupOff;
        device const char* gp3 = r3 + groupOff;
        #pragma unroll
        for (uint p = 0u; p < 8u; p += 2u) {
            if (p + 1u < mRows) {
                half4 xlo0[4], xhi0[4], xlo1[4], xhi1[4];
                qwg_shvq_load_half32(x + (size_t)p * K + col, xlo0, xhi0);
                qwg_shvq_load_half32(x + (size_t)(p + 1u) * K + col, xlo1, xhi1);
                const float2 d0 = qwg_shvq_slice_dot2_tg<BITS>(gp0, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
                const float2 d1 = qwg_shvq_slice_dot2_tg<BITS>(gp1, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
                const float2 d2 = qwg_shvq_slice_dot2_tg<BITS>(gp2, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
                const float2 d3 = qwg_shvq_slice_dot2_tg<BITS>(gp3, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
                acc[p] += float4(d0.x, d1.x, d2.x, d3.x);
                acc[p + 1u] += float4(d0.y, d1.y, d2.y, d3.y);
            } else if (p < mRows) {
                half4 xlo0[4], xhi0[4];
                qwg_shvq_load_half32(x + (size_t)p * K + col, xlo0, xhi0);
                acc[p].x += qwg_shvq_slice_dot_tg<BITS>(gp0, byteInGroup, xlo0, xhi0, tgLut);
                acc[p].y += qwg_shvq_slice_dot_tg<BITS>(gp1, byteInGroup, xlo0, xhi0, tgLut);
                acc[p].z += qwg_shvq_slice_dot_tg<BITS>(gp2, byteInGroup, xlo0, xhi0, tgLut);
                acc[p].w += qwg_shvq_slice_dot_tg<BITS>(gp3, byteInGroup, xlo0, xhi0, tgLut);
            }
        }
    }
    #pragma unroll
    for (uint m = 0u; m < 8u; ++m) {
        if (m < mRows) acc[m] = qwg_simd_reduce_down<32u>(acc[m]);
    }
    if (lane == 0u) {
        #pragma unroll
        for (uint m = 0u; m < 8u; ++m) {
            if (m < mRows) {
                device OutT* ym = y + (size_t)m * realN;
                #pragma unroll
                for (uint r = 0u; r < 4u; ++r) {
                    if (row0 + r < realN) ym[row0 + r] = OutT(acc[m][r]);
                }
            }
        }
    }
}

template <int BITS, int GROUP, uint ROWS, uint LS, bool HAS_TG, bool REDUCE>
METAL_FUNC float4 qwg_gemv_shvq_rows_f32_impl(device const char* blocks,
                                               device const float* x,
                                               size_t rowBase,
                                               uint rowsLeft,
                                               uint K,
                                               uint start,
                                               uint step,
                                               threadgroup const ShvqTgLut<BITS>* tgLut) {
    const uint nBlocks = K >> 5u;
    constexpr uint groupBytes = qwg_shvq_group_bytes(BITS, GROUP);
    constexpr uint slicesPerGroup = uint(GROUP) >> 5u;
    constexpr uint slicePayloadBytes = qwg_shvq_slice_bytes(BITS);
    const uint rowBytes = (K / uint(GROUP)) * groupBytes;
    device const char* r0 = blocks + rowBase * rowBytes;
    device const char* r1 = (ROWS > 1u && rowsLeft > 1u) ? (r0 + rowBytes) : r0;
    device const char* r2 = (ROWS > 2u && rowsLeft > 2u) ? (r0 + 2u * rowBytes) : r0;
    device const char* r3 = (ROWS > 3u && rowsLeft > 3u) ? (r0 + 3u * rowBytes) : r0;
    float4 acc = float4(0.0f);
    const uint gStep = (LS > 0u) ? LS : step;
    for (uint g = start; g < nBlocks; g += gStep) {
        const uint col = g << 5u;
        float4 xlo[4], xhi[4];
        qwg_shvq_load_float32(x + col, xlo, xhi);
        const size_t groupOff = size_t(g / slicesPerGroup) * groupBytes;
        const uint byteInGroup = (g & (slicesPerGroup - 1u)) * slicePayloadBytes;
        if constexpr (HAS_TG) {
            acc.x += qwg_shvq_slice_dot_tg<BITS>(r0 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 1u) acc.y += qwg_shvq_slice_dot_tg<BITS>(r1 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 2u) acc.z += qwg_shvq_slice_dot_tg<BITS>(r2 + groupOff, byteInGroup, xlo, xhi, *tgLut);
            if constexpr (ROWS > 3u) acc.w += qwg_shvq_slice_dot_tg<BITS>(r3 + groupOff, byteInGroup, xlo, xhi, *tgLut);
        } else {
            acc.x += qwg_shvq_slice_dot<BITS>(r0 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 1u) acc.y += qwg_shvq_slice_dot<BITS>(r1 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 2u) acc.z += qwg_shvq_slice_dot<BITS>(r2 + groupOff, byteInGroup, xlo, xhi);
            if constexpr (ROWS > 3u) acc.w += qwg_shvq_slice_dot<BITS>(r3 + groupOff, byteInGroup, xlo, xhi);
        }
    }
    if constexpr (REDUCE) {
        if constexpr (ROWS == 1u) acc.x = qwg_simd_reduce_down<LS>(acc.x);
        else acc = qwg_simd_reduce_down<LS>(acc);
    }
    return acc;
}

template <int BITS, int GROUP, uint LS = 32u>
METAL_FUNC float4 qwg_gemv_shvq_rows4_f32(device const char* blocks, device const float* x,
                                          uint row0, uint N, uint K, uint lane,
                                          threadgroup const ShvqTgLut<BITS> &tgLut) {
    const uint left = (row0 < N) ? (N - row0) : 0u;
    return qwg_gemv_shvq_rows_f32_impl<BITS, GROUP, 4u, LS, true, true>(
        blocks, x, size_t(row0), left, K, lane, LS, &tgLut);
}

template <int BITS, int GROUP, uint LS, uint PAIRS>
METAL_FUNC void qwg_gemv_shvq_rows4_m_pairs_f32(device const char* blocks,
                                                thread device const float* const (&xs)[2 * PAIRS],
                                                uint row0, uint N, uint K, uint lane,
                                                thread float4 (&acc)[2 * PAIRS],
                                                threadgroup const ShvqTgLut<BITS> &tgLut) {
    const uint nBlocks = K >> 5u;
    constexpr uint groupBytes = qwg_shvq_group_bytes(BITS, GROUP);
    constexpr uint slicesPerGroup = uint(GROUP) >> 5u;
    constexpr uint slicePayloadBytes = qwg_shvq_slice_bytes(BITS);
    const uint rowBytes = (K / uint(GROUP)) * groupBytes;
    device const char* r0 = blocks + (size_t)row0 * rowBytes;
    device const char* r1 = (row0 + 1u < N) ? (r0 + rowBytes) : r0;
    device const char* r2 = (row0 + 2u < N) ? (r0 + 2u * rowBytes) : r0;
    device const char* r3 = (row0 + 3u < N) ? (r0 + 3u * rowBytes) : r0;
    #pragma unroll
    for (uint m = 0u; m < 2u * PAIRS; ++m) acc[m] = float4(0.0f);
    for (uint g = lane; g < nBlocks; g += LS) {
        const uint col = g << 5u;
        const size_t groupOff = size_t(g / slicesPerGroup) * groupBytes;
        const uint byteInGroup = (g & (slicesPerGroup - 1u)) * slicePayloadBytes;
        #pragma unroll
        for (uint p = 0u; p < PAIRS; ++p) {
            float4 xlo0[4], xhi0[4], xlo1[4], xhi1[4];
            qwg_shvq_load_float32(xs[2u * p] + col, xlo0, xhi0);
            qwg_shvq_load_float32(xs[2u * p + 1u] + col, xlo1, xhi1);
            const float2 d0 = qwg_shvq_slice_dot2_tg<BITS>(r0 + groupOff, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
            const float2 d1 = qwg_shvq_slice_dot2_tg<BITS>(r1 + groupOff, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
            const float2 d2 = qwg_shvq_slice_dot2_tg<BITS>(r2 + groupOff, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
            const float2 d3 = qwg_shvq_slice_dot2_tg<BITS>(r3 + groupOff, byteInGroup, xlo0, xhi0, xlo1, xhi1, tgLut);
            acc[2u * p] += float4(d0.x, d1.x, d2.x, d3.x);
            acc[2u * p + 1u] += float4(d0.y, d1.y, d2.y, d3.y);
        }
    }
    #pragma unroll
    for (uint m = 0u; m < 2u * PAIRS; ++m) acc[m] = qwg_simd_reduce_down<LS>(acc[m]);
}

template <int BITS, int GROUP, uint LS = 32u>
METAL_FUNC void qwg_gemv_shvq_rows4_m2_f32(device const char* blocks,
                                           device const float* x0, device const float* x1,
                                           uint row0, uint N, uint K, uint lane,
                                           thread float4 &acc0, thread float4 &acc1,
                                           threadgroup const ShvqTgLut<BITS> &tgLut) {
    device const float* const xs[2] = { x0, x1 };
    float4 acc[2];
    qwg_gemv_shvq_rows4_m_pairs_f32<BITS, GROUP, LS, 1u>(blocks, xs, row0, N, K, lane, acc, tgLut);
    acc0 = acc[0];
    acc1 = acc[1];
}

template <int BITS, int GROUP, uint LS = 32u>
METAL_FUNC void qwg_gemv_shvq_rows4_m4_f32(device const char* blocks, device const float* x,
                                           uint M, uint row0, uint N, uint K, uint lane,
                                           thread float4 (&acc)[4],
                                           threadgroup const ShvqTgLut<BITS> &tgLut) {
    device const float* const xs[4] = { x, x + K, x + 2u * K, x + (size_t)min(3u, M - 1u) * K };
    qwg_gemv_shvq_rows4_m_pairs_f32<BITS, GROUP, LS, 2u>(blocks, xs, row0, N, K, lane, acc, tgLut);
}

template <int BITS, int GROUP>
METAL_FUNC float4 qwg_gemv_shvq_rows4_part_f32(device const char* blocks, device const float* x,
                                               uint row0, uint N, uint K,
                                               uint tid, uint nThreads) {
    const uint left = (row0 < N) ? (N - row0) : 0u;
    return qwg_gemv_shvq_rows_f32_impl<BITS, GROUP, 4u, 0u, false, false>(
        blocks, x, size_t(row0), left, K, tid, nThreads, nullptr);
}

template <int BITS, int GROUP>
METAL_FUNC float qwg_gemv_shvq_row_f32_tg(device const char* blocks, device const float* x,
                                          size_t row, uint K, uint lane,
                                          threadgroup const ShvqTgLut<BITS> &tgLut) {
    return qwg_gemv_shvq_rows_f32_impl<BITS, GROUP, 1u, 32u, true, true>(
        blocks, x, row, 1u, K, lane, 32u, &tgLut).x;
}

template <int BITS, int GROUP>
METAL_FUNC float4 qwg_moe_rows4_shvq_f32(device const char* blocks, device const float* x,
                                         size_t rowBase, uint rowsLeft, uint K, uint lane,
                                         threadgroup const ShvqTgLut<BITS> &tgLut) {
    return qwg_gemv_shvq_rows_f32_impl<BITS, GROUP, 4u, 32u, true, true>(
        blocks, x, rowBase, rowsLeft, K, lane, 32u, &tgLut);
}
