/// Constant-cache scalar E4M3FN byte -> half.
inline half qwg_fp8_e4m3_to_half(uchar b) {
    return kQWGFP8E4M3FN_H[b];
}

/// Constant-cache scalar E4M3FN byte -> float.
inline float qwg_fp8_e4m3_to_float(uchar b) {
    return kQWGFP8E4M3FN[b];
}

/// Constant-cache SIMD E4M3FN (4 packed bytes in uint) -> half4.
inline half4 qwg_fp8_e4m3_to_half4(uint packed4) {
    const uchar4 u = as_type<uchar4>(packed4);
    return half4(kQWGFP8E4M3FN_H[u.x], kQWGFP8E4M3FN_H[u.y],
                 kQWGFP8E4M3FN_H[u.z], kQWGFP8E4M3FN_H[u.w]);
}

/// Branchless OCP MXFP8 UE8M0 byte -> float (0 -> 2^-127, 255 -> NaN, else 2^(e-127)).
inline float qwg_ue8m0_to_float(uchar e) {
    uint bits = uint(e) << 23u;
    bits = (e == 0u) ? 0x00400000u : bits;
    bits = (e == 0xFFu) ? 0x7FC00000u : bits;
    return as_type<float>(bits);
}

/// Constant-cache SIMD FP4 E2M1 (4 nibbles in low 16 bits) -> half4.
inline half4 qwg_fp4_e2m1_to_half4(ushort nibbles4) {
    return half4(kQWGFP4Pair_H2[nibbles4 & 0xFFu], kQWGFP4Pair_H2[nibbles4 >> 8u]);
}

/// Unpacks 4 scaled FP4 E2M1 elements for NAX B-fragment construction.
inline half4 qwg_nvfp4_frag4(ushort nibbles4, uchar scByte) {
    return qwg_fp4_e2m1_to_half4(nibbles4) * half4(kQWGFP8E4M3FN_H[scByte]);
}

/// Unpacks 8 NVFP4 weights from w2.x scaled by E4M3FN scByte into lo (0..3) and hi (4..7).
inline void qwg_nvfp4_frag8(uint2 w2, uchar scByte, thread half4 &lo, thread half4 &hi) {
    const half4 sc4 = half4(kQWGFP8E4M3FN_H[scByte]);
    lo = qwg_fp4_e2m1_to_half4(ushort(w2.x & 0xFFFFu)) * sc4;
    hi = qwg_fp4_e2m1_to_half4(ushort(w2.x >> 16u)) * sc4;
}

/// Unpacks a full 16-weight NVFP4 group (w2, scByte) into four half4 vectors.
inline void qwg_nvfp4_group16(uint2 w2, uchar scByte,
                                thread half4 &q0, thread half4 &q1,
                                thread half4 &q2, thread half4 &q3) {
    const half4 sc4 = half4(kQWGFP8E4M3FN_H[scByte]);
    q0 = qwg_fp4_e2m1_to_half4(ushort(w2.x & 0xFFFFu)) * sc4;
    q1 = qwg_fp4_e2m1_to_half4(ushort(w2.x >> 16u)) * sc4;
    q2 = qwg_fp4_e2m1_to_half4(ushort(w2.y & 0xFFFFu)) * sc4;
    q3 = qwg_fp4_e2m1_to_half4(ushort(w2.y >> 16u)) * sc4;
}

/// Unpacks 16 NVFP4 E2M1 weights into FP32 float4 vectors via constant LUT (deferred group scale).
inline void qwg_nvfp4_unpack16_f32(uint2 w2, thread float4 (&a)[4]) {
    const uchar4 b0 = as_type<uchar4>(w2.x);
    const uchar4 b1 = as_type<uchar4>(w2.y);
    a[0] = float4(half4(kQWGFP4Pair_H2[b0.x], kQWGFP4Pair_H2[b0.y]));
    a[1] = float4(half4(kQWGFP4Pair_H2[b0.z], kQWGFP4Pair_H2[b0.w]));
    a[2] = float4(half4(kQWGFP4Pair_H2[b1.x], kQWGFP4Pair_H2[b1.y]));
    a[3] = float4(half4(kQWGFP4Pair_H2[b1.z], kQWGFP4Pair_H2[b1.w]));
}

/// Unnormalized LUT-backed FP32 dot product over a 16-weight NVFP4 group.
inline float qwg_nvfp4_dm16_f32(uint2 w2, thread const float4 (&xv)[4]) {
    float4 a[4];
    qwg_nvfp4_unpack16_f32(w2, a);
    return dot(a[0], xv[0]) + dot(a[1], xv[1]) + dot(a[2], xv[2]) + dot(a[3], xv[3]);
}

/// Direct FP32 LUT dot product over a 16-weight NVFP4 group.
inline float qwg_nvfp4_dot16_f32(uint2 w2, uchar scByte, thread const float4 (&xv)[4]) {
    return qwg_nvfp4_dm16_f32(w2, xv) * kQWGFP8E4M3FN[scByte];
}

/// Generalized SwiGLU supporting standard (cap == 0) and tanh-softcapped (cap > 0) gates/ups.
inline float qwg_fp_softcap_swiglu(float gate, float up, float gateCap, float upCap) {
    const float sig = 1.0f / (1.0f + exp(-gate));
    const float g = (gateCap > 0.0f)
        ? (precise::tanh(clamp(gate / gateCap, -15.0f, 15.0f)) * gateCap * sig)
        : (gate * sig);
    const float u = (upCap > 0.0f) ? (precise::tanh(clamp(up / upCap, -15.0f, 15.0f)) * upCap) : up;
    return g * u;
}

inline float qwg_fp_read(device const char* base, size_t idx, uint dtype) {
    if (dtype == 1u) return float(((device const bfloat*)base)[idx]);
    if (dtype == 2u) return ((device const float*)base)[idx];
    return float(((device const half*)base)[idx]);
}

inline void qwg_fp_write(device char* base, size_t idx, float val, uint dtype) {
    if (dtype == 1u) ((device bfloat*)base)[idx] = qwg_fp_bf16(val);
    else if (dtype == 2u) ((device float*)base)[idx] = val;
    else ((device half*)base)[idx] = half(val);
}

inline float4 qwg_fp_read4(device const char* base, size_t idx, uint dtype) {
    if (dtype == 2u) return *(device const float4*)((device const float*)base + idx);
    const ushort4 raw = *(device const ushort4*)((device const ushort*)base + idx);
    if (dtype == 1u) {
        return float4(as_type<bfloat>(raw.x), as_type<bfloat>(raw.y),
                      as_type<bfloat>(raw.z), as_type<bfloat>(raw.w));
    }
    return float4(as_type<half>(raw.x), as_type<half>(raw.y),
                  as_type<half>(raw.z), as_type<half>(raw.w));
}

inline void qwg_fp_write4(device char* base, size_t idx, float4 v, uint dtype) {
    if (dtype == 2u) { *(device float4*)((device float*)base + idx) = v; return; }
    if (dtype == 1u) {
        *(device ushort4*)((device ushort*)base + idx) = ushort4(
            as_type<ushort>(qwg_fp_bf16(v.x)), as_type<ushort>(qwg_fp_bf16(v.y)),
            as_type<ushort>(qwg_fp_bf16(v.z)), as_type<ushort>(qwg_fp_bf16(v.w)));
        return;
    }
    *(device half4*)((device half*)base + idx) = half4(v);
}

inline void qwg_fp_load_x16(device const char* xPtr, uint dtype, thread float4 (&dst)[4]) {
    dst[0] = qwg_fp_read4(xPtr, 0u, dtype);
    dst[1] = qwg_fp_read4(xPtr, 4u, dtype);
    dst[2] = qwg_fp_read4(xPtr, 8u, dtype);
    dst[3] = qwg_fp_read4(xPtr, 12u, dtype);
}

template <uint M, uint R>
inline void qwg_gemv_bf16_rows_r_m_body(
    device const bfloat* W, device const bfloat* xBF16, device const float* xF32,
    device bfloat* yBF16, device float* yF32, constant QWGemmFPBF16Params& p,
    uint2 tg, uint simd_id, uint lane) {
    const uint rBase = tg.x * (4u * R) + simd_id * R;
    if (rBase >= p.N) return;
    const uint rowsLeft = min(R, p.N - rBase);
    device const bfloat* wRows[R];
    #pragma unroll
    for (uint r = 0u; r < R; ++r) {
        wRows[r] = (r < rowsLeft) ? (W + size_t(rBase + r) * p.K) : (W + size_t(rBase) * p.K);
    }
    float acc[R][M];
    #pragma unroll
    for (uint r = 0u; r < R; ++r) {
        #pragma unroll
        for (uint m = 0u; m < M; ++m) acc[r][m] = 0.0f;
    }

    const bool vecW = ((p.K & 7u) == 0u) && ((size_t(W) & 15u) == 0u);
    const bool vecX = (p.inIsF32 == 1u)
        ? (((p.strideX & 3u) == 0u) && ((size_t(xF32) & 15u) == 0u))
        : (((p.strideX & 7u) == 0u) && ((size_t(xBF16) & 15u) == 0u));

    if (vecW && vecX) {
        for (uint k = lane * 8u; k < p.K; k += 256u) {
            float4 wf0[R], wf1[R];
            #pragma unroll
            for (uint r = 0u; r < R; ++r) {
                const uint4 va = *(device const uint4*)(wRows[r] + k);
                wf0[r] = float4(as_type<bfloat>(ushort(va.x)), as_type<bfloat>(ushort(va.x >> 16u)),
                                as_type<bfloat>(ushort(va.y)), as_type<bfloat>(ushort(va.y >> 16u)));
                wf1[r] = float4(as_type<bfloat>(ushort(va.z)), as_type<bfloat>(ushort(va.z >> 16u)),
                                as_type<bfloat>(ushort(va.w)), as_type<bfloat>(ushort(va.w >> 16u)));
            }
            #pragma unroll
            for (uint m = 0u; m < M; ++m) {
                float4 xf0, xf1;
                if (p.inIsF32 == 1u) {
                    device const float* xr = xF32 + size_t(m) * p.strideX + k;
                    xf0 = *(device const float4*)xr; xf1 = *(device const float4*)(xr + 4u);
                } else {
                    const uint4 vb = *(device const uint4*)((device const ushort*)xBF16 + size_t(m) * p.strideX + k);
                    if (p.inIsF32 == 2u) {
                        xf0 = float4(as_type<half>(ushort(vb.x)), as_type<half>(ushort(vb.x >> 16u)),
                                     as_type<half>(ushort(vb.y)), as_type<half>(ushort(vb.y >> 16u)));
                        xf1 = float4(as_type<half>(ushort(vb.z)), as_type<half>(ushort(vb.z >> 16u)),
                                     as_type<half>(ushort(vb.w)), as_type<half>(ushort(vb.w >> 16u)));
                    } else {
                        xf0 = float4(as_type<bfloat>(ushort(vb.x)), as_type<bfloat>(ushort(vb.x >> 16u)),
                                     as_type<bfloat>(ushort(vb.y)), as_type<bfloat>(ushort(vb.y >> 16u)));
                        xf1 = float4(as_type<bfloat>(ushort(vb.z)), as_type<bfloat>(ushort(vb.z >> 16u)),
                                     as_type<bfloat>(ushort(vb.w)), as_type<bfloat>(ushort(vb.w >> 16u)));
                    }
                }
                #pragma unroll
                for (uint r = 0u; r < R; ++r) acc[r][m] = qwg_fp_dot8_fma(wf0[r], wf1[r], xf0, xf1, acc[r][m]);
            }
        }
    } else {
        for (uint k = lane; k < p.K; k += 32u) {
            float wv[R];
            #pragma unroll
            for (uint r = 0u; r < R; ++r) wv[r] = float(wRows[r][k]);
            #pragma unroll
            for (uint m = 0u; m < M; ++m) {
                const size_t xIdx = size_t(m) * p.strideX + k;
                const float xv = (p.inIsF32 == 1u) ? xF32[xIdx]
                    : ((p.inIsF32 == 2u) ? float(((device const half*)xBF16)[xIdx]) : float(xBF16[xIdx]));
                #pragma unroll
                for (uint r = 0u; r < R; ++r) acc[r][m] = fma(wv[r], xv, acc[r][m]);
            }
        }
    }

    #pragma unroll
    for (uint r = 0u; r < R; ++r) {
        #pragma unroll
        for (uint m = 0u; m < M; ++m) {
            float val = simd_sum(acc[r][m]);
            if (lane == 0u && r < rowsLeft && m < p.M) {
                const size_t yIdx = size_t(m) * p.strideY + rBase + r;
                if (p.addResidual != 0u) {
                    if (p.outIsF32 == 1u) val += yF32[yIdx];
                    else if (p.outIsF32 == 2u) val += float(((device const half*)yBF16)[yIdx]);
                    else val += float(yBF16[yIdx]);
                }
                if (p.softcap > 0.0f) val = precise::tanh(clamp(val / p.softcap, -15.0f, 15.0f)) * p.softcap;
                if (p.outIsF32 == 1u) yF32[yIdx] = val;
                else if (p.outIsF32 == 2u) ((device half*)yBF16)[yIdx] = half(val);
                else yBF16[yIdx] = qwg_fp_bf16(val);
            }
        }
    }
}
