// qw_dequant_fp.metalh — Constant-cache LUTs (2.5 KiB << 32 KiB) & branchless SIMD unpack + BF16 GEMV helpers.
#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
using namespace metal;

struct QWGemmFPBF16Params {
    uint M, N, K, strideX, strideY, inIsF32, outIsF32, addResidual;
    float softcap;
};

struct QWGemmFPCompactMoEParams {
    uint N, K, topK, numExperts, wExpertRows, upRowBias, inDtype, outDtype, flags;
    float gateCap, upCap;
};

/// IEEE-754 round-to-nearest-even float -> bfloat conversion.
inline bfloat qwg_fp_bf16(float v) {
    uint u = as_type<uint>(v);
    if ((u & 0x7F800000u) == 0x7F800000u) return bfloat(v);
    u = u + 0x7FFFu + ((u >> 16u) & 1u);
    return bfloat(as_type<float>(u & 0xFFFF0000u));
}

inline float qwg_fp_dot4_init(float4 a, float4 b) {
    return fma(a.w, b.w, fma(a.z, b.z, fma(a.y, b.y, a.x * b.x)));
}

inline float qwg_fp_dot4_fma(float4 a, float4 b, float acc) {
    return fma(a.w, b.w, fma(a.z, b.z, fma(a.y, b.y, fma(a.x, b.x, acc))));
}

inline float qwg_fp_dot8_fma(float4 w0, float4 w1, float4 x0, float4 x1, float acc) {
    return qwg_fp_dot4_fma(w1, x1, qwg_fp_dot4_fma(w0, x0, acc));
}

