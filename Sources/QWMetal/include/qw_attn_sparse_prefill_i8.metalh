// qw_attn_sparse_prefill_i8.metalh — Sparse prefill helpers and INT8 NAX QxK body.
// Preserves dense NAX i8 QxK throughput for q8/q4 sparse paged prefill (f16 V).
#if !defined(__ENVIRONMENT_OS_VERSION_MIN_REQUIRED__) || __ENVIRONMENT_OS_VERSION_MIN_REQUIRED__ < 260200
#error "qw_attn_sparse_prefill_i8.metalh requires -mmacosx-version-min=26.2 for Metal 4 NAX"
#endif

#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
#include "mlx/backend/metal/kernels/steel/gemm/nax.h"

#define QW_LSA_KU 16u
#define QW_LSA_BK 32u

static inline void lsa_sparse_resolve_slot_page(
        uint slotIdx, uint uCount, uint tailStart, uint totalSlots, uint kEnd,
        const device int* myList, const device int* ktab, const device int* vtab,
        uint tid,
        thread uint& outAbsKey, thread uint& outPk, thread uint& outPv) {
    uint absKey = 0u, pk = 0u, pv = 0u;
    const bool needWarp = (QW_HEAD_DIM == 256u) || (QW_HEAD_DIM == 128u);
    const bool leader = (QW_HEAD_DIM == 256u) ? ((tid & 31u) == 0u)
                      : (QW_HEAD_DIM == 128u) ? ((tid & 15u) == 0u) : true;
    if (leader && slotIdx < totalSlots) {
        absKey = (slotIdx < uCount * 4u)
            ? (uint(myList[slotIdx >> 2u]) * 4u + (slotIdx & 3u))
            : (tailStart + (slotIdx - uCount * 4u));
        if (absKey < kEnd) {
            const uint page = absKey >> 8u;
            pk = (uint)ktab[page];
            pv = (uint)vtab[page];
        }
    }
    if (needWarp) {
        const ushort src = (QW_HEAD_DIM == 256u) ? ushort(0) : ushort(tid & 16u);
        absKey = simd_shuffle(absKey, src);
        pk = simd_shuffle(pk, src);
        pv = simd_shuffle(pv, src);
    }
    outAbsKey = absKey;
    outPk = pk;
    outPv = pv;
}

template <uint STAGE_HDIM>
METAL_FUNC void lsa_sparse_nax_epilogue(
        thread mlx::steel::NAXTile<float, 1, STAGE_HDIM / 16u>& Otile,
        thread float (&lrow)[2],
        const device half* qdev, device half* outp,
        uint rowBase, uint head, short validRows, uint sn, short nq, short npair) {
    constexpr short kU = 16;
    constexpr short kMaxPair = short(STAGE_HDIM >> 5u);
    float linv[2];
    STEEL_PRAGMA_UNROLL
    for (short i = 0; i < 2; i++) linv[i] = (lrow[i] > 0.0f) ? (1.0f / lrow[i]) : 0.0f;

    const device half* gdev = qdev + QW_HEAD_DIM;
    device half* odev = outp + (uint64_t)rowBase * (QW_Q_HEADS * QW_HEAD_DIM)
                        + (uint64_t)head * QW_HEAD_DIM;

    STEEL_PRAGMA_UNROLL
    for (short idp = 0; idp < kMaxPair; idp++) {
        if (idp < npair) {
            const short id0 = idp * 2;
            const short id1 = id0 + 1;
            mlx::steel::NAXTile<half, 1, 1> G0, G1;
            if (QW_HAS_Q_GATE) {
                if (validRows == 16) {
                    G0.load(gdev + id0 * kU, int(QW_QPROJ_OUT));
                    G1.load(gdev + id1 * kU, int(QW_QPROJ_OUT));
                } else {
                    G0.load_safe(gdev + id0 * kU, int(QW_QPROJ_OUT), short2(kU, validRows));
                    G1.load_safe(gdev + id1 * kU, int(QW_QPROJ_OUT), short2(kU, validRows));
                }
            }
            thread auto& of0 = Otile.frag_at(0, id0);
            thread auto& of1 = Otile.frag_at(0, id1);
            thread auto& gf0 = G0.frag_at(0, 0);
            thread auto& gf1 = G1.frag_at(0, 0);

            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; i++) {
                float w[8];
                STEEL_PRAGMA_UNROLL
                for (short j = 0; j < 4; j++) {
                    const short loc = i * 4 + j;
                    const float g0 = QW_HAS_Q_GATE ? (1.0f / (1.0f + metal::fast::exp(-float(gf0[loc])))) : 1.0f;
                    const float g1 = QW_HAS_Q_GATE ? (1.0f / (1.0f + metal::fast::exp(-float(gf1[loc])))) : 1.0f;
                    w[j]     = of0[loc] * linv[i] * g0;
                    w[4 + j] = of1[loc] * linv[i] * g1;
                }
                if (QW_FWHT_ROTATED) {
                    const float a0 = w[0] + w[1], a1 = w[0] - w[1];
                    const float a2 = w[2] + w[3], a3 = w[2] - w[3];
                    const float b0 = a0 + a2,     b2 = a0 - a2;
                    const float b1 = a1 + a3,     b3 = a1 - a3;
                    const float c0 = w[4] + w[5], c1 = w[4] - w[5];
                    const float c2 = w[6] + w[7], c3 = w[6] - w[7];
                    const float d0 = c0 + c2,     d2 = c0 - c2;
                    const float d1 = c1 + c3,     d3 = c1 - c3;
                    w[0] = b0; w[1] = b1; w[2] = b2; w[3] = b3;
                    w[4] = d0; w[5] = d1; w[6] = d2; w[7] = d3;
                    const bool hi4 = (sn & 4u) != 0u;
                    const bool hi8 = (sn & 8u) != 0u;
                    STEEL_PRAGMA_UNROLL
                    for (short k = 0; k < 8; k++) {
                        const float p4 = simd_shuffle_xor(w[k], ushort(1));
                        w[k] = hi4 ? (p4 - w[k]) : (w[k] + p4);
                    }
                    STEEL_PRAGMA_UNROLL
                    for (short k = 0; k < 8; k++) {
                        const float p8 = simd_shuffle_xor(w[k], ushort(8));
                        w[k] = hi8 ? (p8 - w[k]) : (w[k] + p8);
                    }
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) {
                        const float u = w[j], v = w[4 + j];
                        w[j]     = (u + v) * 0.17677669529663689f;
                        w[4 + j] = (u - v) * 0.17677669529663689f;
                    }
                }
                STEEL_PRAGMA_UNROLL
                for (short j = 0; j < 4; j++) {
                    const short loc = i * 4 + j;
                    gf0[loc] = half(w[j]);
                    gf1[loc] = half(w[4 + j]);
                }
            }
            if (validRows == 16) {
                G0.store(odev + id0 * kU, int(QW_Q_HEADS * QW_HEAD_DIM));
                G1.store(odev + id1 * kU, int(QW_Q_HEADS * QW_HEAD_DIM));
            } else if (validRows > 0) {
                G0.store_safe(odev + id0 * kU, int(QW_Q_HEADS * QW_HEAD_DIM), short2(kU, validRows));
                G1.store_safe(odev + id1 * kU, int(QW_Q_HEADS * QW_HEAD_DIM), short2(kU, validRows));
            }
        }
    }
    (void)nq;
}

template <uint MODE, uint STAGE_HDIM>
METAL_FUNC void lsa_prefill_paged_nax_sparse_i8_body(
        const device half* qgate, const device half* kpool, const device half* vpool,
        const device int* ktab, const device int* vtab, device half* outp,
        constant uint& pos, constant uint& T,
        const device int* blockList, const device uint* blockCountBuf, constant uint& listStride,
        uint tid, uint sgi, uint3 tg,
        threadgroup int8_t* kvblk_i8, threadgroup float* kScale, threadgroup half* vblk) {
    using mlx::steel::BaseNAXFrag;
    using mlx::steel::NAXTile;
    const uint kThreads   = 64u * QW_GQA_RATIO;
    const uint num_groups = QW_KV_HEADS;
    const uint kvh        = tg.x % num_groups;
    const uint tile0      = (tg.x / num_groups) * 32u;
    const uint headBase   = kvh * QW_GQA_RATIO;
    const uint qRef       = min(tile0 + 31u, T - 1u);
    const uint kEnd       = pos + min(tile0 + 32u, T);

    const uint totalCompleteBlocks = kEnd >> 2u;
    const uint uCount     = min(blockCountBuf[qRef], totalCompleteBlocks);
    const uint tailStart  = totalCompleteBlocks * 4u;
    const uint nTail      = (kEnd > tailStart) ? (kEnd - tailStart) : 0u;
    const uint totalSlots = uCount * 4u + nTail;
    const device int* myList = blockList + uint64_t(qRef) * listStride;

    const uint sgi_h     = sgi >> 1u;
    const uint sgi_local = sgi & 1u;
    const uint head      = headBase + sgi_h;
    const uint rowBase   = tile0 + sgi_local * QW_LSA_KU;

    const float scale2 = QW_ATTN_SCALE * 1.4426950408889634f;
    constexpr short kU = 16;
    constexpr short kMaxNq = short(STAGE_HDIM >> 4u);
    constexpr short kMaxPair = short(STAGE_HDIM >> 5u);
    const short nq = short(QW_HEAD_DIM >> 4u);
    const short npair = short(QW_HEAD_DIM >> 5u);

    const device half* qdev = qgate + (uint64_t)rowBase * QW_QPROJ_OUT
                              + (uint64_t)head * QW_Q_STRIDE * QW_HEAD_DIM;
    const short2 sc = BaseNAXFrag::get_coord();
    const short sm = sc.y, sn = sc.x;
    const short validRows = short(clamp(int(T) - int(rowBase), 0, 16));

    NAXTile<int8_t, 1, 1> Qfi8[kMaxNq];
    float qScale2[2];
    {
        NAXTile<half, 1, 1> Qf[kMaxNq];
        STEEL_PRAGMA_UNROLL
        for (short id = 0; id < kMaxNq; id++) {
            if (id < nq) {
                if (validRows == 16)
                    Qf[id].load(qdev + id * kU, int(QW_QPROJ_OUT));
                else
                    Qf[id].load_safe(qdev + id * kU, int(QW_QPROJ_OUT), short2(kU, validRows));
            }
        }
        float qmax[2] = {0.0f, 0.0f};
        STEEL_PRAGMA_UNROLL
        for (short id = 0; id < kMaxNq; id++) {
            if (id < nq) {
                thread auto& fg = Qf[id].frag_at(0, 0);
                STEEL_PRAGMA_UNROLL
                for (short i = 0; i < 2; i++) {
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) qmax[i] = fmax(qmax[i], fabs(float(fg[i * 4 + j])));
                }
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            qmax[i] = max(qmax[i], simd_shuffle_xor(qmax[i], ushort(1)));
            qmax[i] = max(qmax[i], simd_shuffle_xor(qmax[i], ushort(8)));
        }
        float qInv[2];
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            qScale2[i] = (qmax[i] > 0.0f) ? ((qmax[i] / 127.0f) * scale2) : 0.0f;
            qInv[i]    = (qmax[i] > 0.0f) ? (127.0f / qmax[i]) : 0.0f;
        }
        STEEL_PRAGMA_UNROLL
        for (short id = 0; id < kMaxNq; id++) {
            if (id < nq) {
                thread auto& src = Qf[id].frag_at(0, 0);
                thread auto& dst = Qfi8[id].frag_at(0, 0);
                STEEL_PRAGMA_UNROLL
                for (short i = 0; i < 2; i++) {
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) dst[i * 4 + j] = int8_t(rint(float(src[i * 4 + j]) * qInv[i]));
                }
            }
        }
    }

    NAXTile<float, 1, kMaxNq> Otile;
    Otile.clear();
    float mrow[2], lrow[2];
    STEEL_PRAGMA_UNROLL
    for (short i = 0; i < 2; i++) { mrow[i] = -1e30f; lrow[i] = 0.0f; }

    const uint kLoadVec8 = 4u * QW_HEAD_DIM;
    constexpr uint kStageStrideI8 = STAGE_HDIM + 16u;
    constexpr uint kStageStrideV  = STAGE_HDIM;

    for (uint s0 = 0u; s0 < totalSlots; s0 += QW_LSA_BK) {
        NAXTile<half, 1, 2> Pt;
        for (uint e = tid; e < kLoadVec8; e += kThreads) {
            const uint VecPerRow = QW_HEAD_DIM >> 3u;
            const uint kr = (QW_HEAD_DIM == 256u) ? (e >> 5u) : (e / VecPerRow);
            const uint laneInRow = (QW_HEAD_DIM == 256u) ? (e & 31u) : (e % VecPerRow);
            const uint dim0 = laneInRow << 3u;
            const uint slotIdx = s0 + kr;
            uint absKey, pk, pv;
            lsa_sparse_resolve_slot_page(slotIdx, uCount, tailStart, totalSlots, kEnd,
                                         myList, ktab, vtab, tid, absKey, pk, pv);
            const uint obI8 = kr * kStageStrideI8 + dim0;
            const uint obV  = kr * kStageStrideV  + dim0;
            half kh[8];
            if (slotIdx < totalSlots && absKey < kEnd) {
                const uint slot = absKey & 255u;
                if (MODE == 1u) {
                    const uint64_t pageOff = (uint64_t)pk * QW_Q8_PGE;
                    const device char* sk8 = (const device char*)kpool + pageOff
                                             + (uint64_t)slot * QW_ROW8 + (uint64_t)kvh * QW_HEAD_DIM + dim0;
                    *(threadgroup char4*)(kvblk_i8 + obI8)      = *(const device char4*)sk8;
                    *(threadgroup char4*)(kvblk_i8 + obI8 + 4u) = *(const device char4*)(sk8 + 4u);
                    if (laneInRow == 0u) {
                        kScale[kr] = float(*(const device half*)((const device char*)kpool + pageOff + QW_Q8_HDR
                                           + (uint64_t)slot * QW_Q8_HROW + (uint64_t)kvh * 2u));
                    }
                    qwg_q8_load8((const device char*)vpool, (uint64_t)pv * QW_Q8_PGE, slot, kvh, dim0, vblk, obV);
                } else {
                    qwg_q4_load8((const device uchar*)kpool, (uint64_t)pk * QW_Q4_PGE, slot, kvh, dim0, kh, 0u);
                    qwg_q4_load8((const device uchar*)vpool, (uint64_t)pv * QW_Q4_PGE, slot, kvh, dim0, vblk, obV);
                }
            } else {
                STEEL_PRAGMA_UNROLL
                for (uint i = 0u; i < 8u; i++) kh[i] = half(0.0h);
                if (MODE == 1u) {
                    *(threadgroup char4*)(kvblk_i8 + obI8)      = char4(0);
                    *(threadgroup char4*)(kvblk_i8 + obI8 + 4u) = char4(0);
                    if (laneInRow == 0u) kScale[kr] = 0.0f;
                }
                *(threadgroup half4*)(vblk + obV)      = half4(0.0h);
                *(threadgroup half4*)(vblk + obV + 4u) = half4(0.0h);
            }
            if (MODE != 1u) {
                float amax = 0.0f;
                STEEL_PRAGMA_UNROLL
                for (uint i = 0u; i < 8u; i++) amax = fmax(amax, fabs(float(kh[i])));
                if (QW_HEAD_DIM == 256u) {
                    amax = simd_max(amax);
                } else {
                    for (uint off = VecPerRow >> 1u; off > 0u; off >>= 1u)
                        amax = fmax(amax, simd_shuffle_xor(amax, ushort(off)));
                }
                const float inv = (amax > 0.0f) ? (127.0f / amax) : 0.0f;
                char4 q0, q1;
                STEEL_PRAGMA_UNROLL
                for (uint i = 0u; i < 4u; i++) {
                    q0[i] = char(int(rint(float(kh[i]) * inv)));
                    q1[i] = char(int(rint(float(kh[i + 4u]) * inv)));
                }
                *(threadgroup char4*)(kvblk_i8 + obI8)      = q0;
                *(threadgroup char4*)(kvblk_i8 + obI8 + 4u) = q1;
                if (laneInRow == 0u) kScale[kr] = amax / 127.0f;
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        NAXTile<int32_t, 1, 2> Stile_i32;
        Stile_i32.clear();
        STEEL_PRAGMA_UNROLL
        for (short id = 0; id < kMaxNq; id++) {
            if (id < nq) {
                NAXTile<int8_t, 2, 1> Kt;
                Kt.template load<int8_t, kStageStrideI8, 1>(kvblk_i8 + id * kU);
                BaseNAXFrag::mma(Stile_i32.frag_at(0, 0),
                                 Stile_i32.frag_at(0, 1),
                                 Qfi8[id].frag_at(0, 0), metal::false_type{},
                                 Kt.frag_at(0, 0), Kt.frag_at(1, 0),
                                 metal::true_type{});
            }
        }

        const uint lastSlotInStep = s0 + QW_LSA_BK - 1u;
        const uint maxAbsKeyInStep = (lastSlotInStep < uCount * 4u)
            ? (uint(myList[lastSlotInStep >> 2u]) * 4u + (lastSlotInStep & 3u))
            : (tailStart + (lastSlotInStep - uCount * 4u));
        const bool isUnmasked = (s0 + QW_LSA_BK <= totalSlots) && (maxAbsKeyInStep <= pos + rowBase);

        NAXTile<float, 1, 2> Stile;
        STEEL_PRAGMA_UNROLL
        for (short ik = 0; ik < 2; ik++) {
            const uint kColBase = uint(ik * kU) + uint(sn);
            const float4 ks = *(const threadgroup float4*)(kScale + kColBase);
            thread auto& ifg = Stile_i32.frag_at(0, ik);
            thread auto& fg  = Stile.frag_at(0, ik);
            if (isUnmasked) {
                STEEL_PRAGMA_UNROLL
                for (short i = 0; i < 2; i++) {
                    const float qs = qScale2[i];
                    fg[i * 4 + 0] = float(ifg[i * 4 + 0]) * (qs * ks.x);
                    fg[i * 4 + 1] = float(ifg[i * 4 + 1]) * (qs * ks.y);
                    fg[i * 4 + 2] = float(ifg[i * 4 + 2]) * (qs * ks.z);
                    fg[i * 4 + 3] = float(ifg[i * 4 + 3]) * (qs * ks.w);
                }
            } else {
                const uint col0 = s0 + kColBase;
                const float ksv[4] = {ks.x, ks.y, ks.z, ks.w};
                STEEL_PRAGMA_UNROLL
                for (short loc = 0; loc < BaseNAXFrag::kElemsPerFrag; loc++) {
                    const uint i = (uint)(loc >> 2), j = (uint)(loc & 3);
                    const uint slotC = col0 + j;
                    const uint abs_cc = (slotC < uCount * 4u)
                        ? (uint(myList[slotC >> 2u]) * 4u + (slotC & 3u))
                        : (tailStart + (slotC - uCount * 4u));
                    const uint abs_rr = pos + rowBase + (uint)sm + i * 8u;
                    fg[loc] = (slotC < totalSlots && abs_cc <= abs_rr && abs_cc < (pos + T))
                        ? (float(ifg[loc]) * (qScale2[i] * ksv[j]))
                        : (-1e30f);
                }
            }
        }

        float mnew[2];
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) mnew[i] = mrow[i];
        STEEL_PRAGMA_UNROLL
        for (short ik = 0; ik < 2; ik++) {
            thread auto& fg = Stile.frag_at(0, ik);
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < BaseNAXFrag::kElemRows; i++) {
                float v = fg[i * 4 + 0] > fg[i * 4 + 1] ? fg[i * 4 + 0] : fg[i * 4 + 1];
                v = v > fg[i * 4 + 2] ? v : fg[i * 4 + 2];
                v = v > fg[i * 4 + 3] ? v : fg[i * 4 + 3];
                mnew[i] = mnew[i] > v ? mnew[i] : v;
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(1)));
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(8)));
        }

        float psum[2] = {0.0f, 0.0f};
        STEEL_PRAGMA_UNROLL
        for (short ik = 0; ik < 2; ik++) {
            thread auto& sf = Stile.frag_at(0, ik);
            thread auto& pf = Pt.frag_at(0, ik);
            STEEL_PRAGMA_UNROLL
            for (short loc = 0; loc < BaseNAXFrag::kElemsPerFrag; loc++) {
                const short i = loc >> 2;
                const float x = (isUnmasked || sf[loc] > -1e29f) ? metal::fast::exp2(sf[loc] - mnew[i]) : 0.0f;
                pf[loc] = half(x);
                psum[i] += x;
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            psum[i] += simd_shuffle_xor(psum[i], ushort(1));
            psum[i] += simd_shuffle_xor(psum[i], ushort(8));
        }

        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            const bool grew = (mnew[i] > mrow[i]) && (mrow[i] > -1e29f);
            const float corr = grew ? metal::fast::exp2(mrow[i] - mnew[i]) : 1.0f;
            lrow[i] = lrow[i] * corr + psum[i];
            if (grew) {
                STEEL_PRAGMA_UNROLL
                for (short id = 0; id < kMaxNq; id++) {
                    if (id < nq) {
                        thread auto& of = Otile.frag_at(0, id);
                        STEEL_PRAGMA_UNROLL
                        for (short j = 0; j < 4; j++) of[i * 4 + j] *= corr;
                    }
                }
            }
            mrow[i] = mnew[i];
        }

        STEEL_PRAGMA_UNROLL
        for (short ik = 0; ik < 2; ik++) {
            STEEL_PRAGMA_UNROLL
            for (short idp = 0; idp < kMaxPair; idp++) {
                if (idp < npair) {
                    const short id0 = idp * 2;
                    NAXTile<half, 1, 2> Vt;
                    Vt.template load<half, kStageStrideV, 1>(vblk + (ik * kU) * kStageStrideV + id0 * kU);
                    BaseNAXFrag::mma(Otile.frag_at(0, id0),
                                     Otile.frag_at(0, id0 + 1),
                                     Pt.frag_at(0, ik), metal::false_type{},
                                     Vt.frag_at(0, 0), Vt.frag_at(0, 1),
                                     metal::false_type{});
                }
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    lsa_sparse_nax_epilogue<STAGE_HDIM>(Otile, lrow, qdev, outp, rowBase, head, validRows, uint(sn), nq, npair);
}
