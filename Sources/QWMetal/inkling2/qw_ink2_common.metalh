// qw_ink2_common.metalh — Shared math helpers and parameter structs for Inkling-2 kernels.
#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
using namespace metal;

inline bfloat qw_ink2_bf16(float v) {
    uint u = as_type<uint>(v);
    if ((u & 0x7F800000u) == 0x7F800000u) return bfloat(v);
    u = u + 0x7FFFu + ((u >> 16u) & 1u);
    return bfloat(as_type<float>(u & 0xFFFF0000u));
}

inline float qw_ink2_fp8_e8m0(uchar b) {
    if (b == 0xFFu) return as_type<float>(0x7FC00000u);
    if (b == 0u) return as_type<float>(0x00400000u);
    return as_type<float>(uint(b) << 23u);
}

inline float qw_ink2_sigmoid(float x) {
    return 1.0f / (1.0f + exp(-x));
}

inline float qw_ink2_tanh_safe(float x) {
    return tanh(clamp(x, -15.0f, 15.0f));
}

inline float qw_ink2_softcap_swiglu(float gate, float up, float gateCap, float upCap) {
    float g = qw_ink2_tanh_safe(gate / gateCap) * gateCap * qw_ink2_sigmoid(gate);
    float u = qw_ink2_tanh_safe(up / upCap) * upCap;
    return float(qw_ink2_bf16(g * u));
}

struct QWInk2EmbedParams {
    uint T;
    uint H;
    uint V;
    float eps;
};

struct QWInk2NormParams {
    uint rows;
    uint dim;
    uint inIsF32;
